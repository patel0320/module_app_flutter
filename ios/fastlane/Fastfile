# Fastfile for iOS build + TestFlight deploy.
#
# Signing assets are supplied as base64 secrets decoded to disk by the
# workflow: a Distribution certificate (.p12) and a provisioning profile
# (.mobileprovision). This lane imports/installs them, builds the signed IPA
# and uploads it to TestFlight — no match repo / certificate server needed.
#
# Required env (set from CI secrets in .github/workflows/build_deploy.yml):
#   IOS_CERT_P12_PATH          Path to the decoded signing certificate .p12
#   IOS_CERT_P12_PASSWORD      Password of the .p12
#   IOS_MOBILEPROVISION_PATH   Path to the decoded .mobileprovision
#   IOS_APPLE_BUNDLE_ID        iOS bundle identifier (com.soleux.sdm)
#   APP_ENV                    Build environment (dev/staging/prod dart-define)
#
# TestFlight upload auth — one of the following:
#   App Store Connect API key (preferred):
#     IOS_MATCH_CERT_API_KEY        Base64 of the .p8 private key content
#     IOS_MATCH_CERT_API_KEY_ID     App Store Connect API key ID
#     IOS_MATCH_CERT_ISSUER_ID      App Store Connect API key issuer ID
#   or username + app-specific password:
#     FASTLANE_USER / FASTLANE_PASSWORD / IOS_APPLE_APP_SPECIFIC_PASSWORD

default_platform(:ios)

# Directory of this Fastfile = <repo>/ios/fastlane, so <repo> is one level up.
FASTLANE_DIR = __dir__
FLUTTER_ROOT = File.expand_path("..", FASTLANE_DIR)

# App Store Connect API key object, or nil when the secret is not configured so
# upload_to_testflight falls back to username / app-specific-password auth.
def asc_api_key
  return nil if ENV["IOS_MATCH_CERT_API_KEY_ID"].to_s.empty?

  app_store_connect_api_key(
    key_id: ENV["IOS_MATCH_CERT_API_KEY_ID"],
    issuer_id: ENV["IOS_MATCH_CERT_ISSUER_ID"],
    key: ENV["IOS_MATCH_CERT_API_KEY"],
    is_key_content_base64: true,
    duration: 1200
  )
end

desc "Build a signed IPA and upload it to TestFlight"
lane :beta do
  # Import the Distribution certificate + private key into the login keychain.
  import_certificate(
    certificate_path: ENV["IOS_CERT_P12_PATH"],
    certificate_password: ENV["IOS_CERT_P12_PASSWORD"],
    keychain_name: "login.keychain",
    keychain_password: ""
  )

  # Allow codesign to use the imported key without a GUI prompt (headless CI).
  sh("security", "unlock-keychain", "-p", "", "login.keychain")
  sh("security", "set-key-partition-list", "-S", "apple-tool:,apple:", "-s",
     "-k", "", "login.keychain")

  # Install the App Store distribution provisioning profile.
  install_provisioning_profile(path: ENV["IOS_MOBILEPROVISION_PATH"])

  # flutter build ipa must run from the project root (not from ios/).
  # --export-method=app-store-connect signs for App Store / TestFlight.
  sh("cd #{FLUTTER_ROOT} && flutter build ipa --release " \
     "--dart-define=APP_ENV=#{ENV["APP_ENV"]} " \
     "--export-method=app-store-connect")

  upload_to_testflight(
    api_key: asc_api_key,
    app_identifier: ENV["IOS_APPLE_BUNDLE_ID"],
    ipa: File.join(FLUTTER_ROOT, "build", "ios", "ipa", "Runner.ipa"),
    skip_waiting_for_build_processing: false
  )
end