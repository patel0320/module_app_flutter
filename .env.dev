# Development environment (local dev, mock transports).
# Values here are non-secret defaults; real credentials live in CI secrets and
# are injected via --dart-define. Do not commit secrets to this repo.
APP_ENV=dev
MQTT_HOST=broker.local
MQTT_PORT=8883
MQTT_TLS=true
LAN_COMMAND_TIMEOUT_MS=300
DISCOVERY_PORT=5353
EVENT_LOG_RETENTION_DAYS=30
